# ── Application ───────────────────────────────────────────────
APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=change-me
# Chiffre les clés API des providers en base (AES-256-GCM). 32 octets en base64.
# openssl rand -base64 32
ENCRYPTION_KEY=change-me
# Le premier compte créé devient administrateur de l'instance.
# Pour en désigner d'autres : liste d'emails séparés par des virgules.
ADMIN_EMAILS=

# ── Base de données ───────────────────────────────────────────
DATABASE_URL=postgresql://regie:regie@localhost:5432/regie

# ── File de jobs ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# ── Stockage objet (S3, R2, Supabase Storage, MinIO) ──────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=regie
S3_ACCESS_KEY_ID=regie
S3_SECRET_ACCESS_KEY=regie-secret
# true pour MinIO et la plupart des S3 auto-hébergés
S3_FORCE_PATH_STYLE=true
# Taille max d'un upload, en mégaoctets
UPLOAD_MAX_MB=50

# ── Authentification (optionnel) ──────────────────────────────
# Laisser vide pour désactiver le fournisseur correspondant.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Providers IA ──────────────────────────────────────────────
# Rien à mettre ici : les providers se configurent dans l'interface
# (Réglages → Providers IA) et leurs clés sont chiffrées en base.
# Ces variables, si présentes, pré-remplissent les providers au seed.
SEED_OPENAI_API_KEY=
SEED_ANTHROPIC_API_KEY=
SEED_GOOGLE_API_KEY=
SEED_FAL_KEY=
SEED_REPLICATE_API_TOKEN=
SEED_RUNWAY_API_KEY=
SEED_LUMA_API_KEY=
SEED_ELEVENLABS_API_KEY=
SEED_OLLAMA_URL=
SEED_COMFYUI_URL=
